<%= form_with(model: reference_value, class: "contents") do |form| %>
  <% if reference_value.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(reference_value.errors.count, "error") %> prohibited this reference_value from being saved:</h2>

      <ul class="list-disc ml-6">
        <% reference_value.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :gender_related %>
    <%= form.number_field :gender_related, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:gender_related].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:gender_related].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :measure_unit %>
    <%= form.number_field :measure_unit, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:measure_unit].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:measure_unit].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :value %>
    <%= form.text_field :value, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:value].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:value].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :exam_id %>
    <%= form.text_field :exam_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:exam_id].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:exam_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :min_age %>
    <%= form.number_field :min_age, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:min_age].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:min_age].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :min_age_kind %>
    <%= form.number_field :min_age_kind, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:min_age_kind].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:min_age_kind].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :max_age %>
    <%= form.number_field :max_age, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:max_age].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:max_age].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :max_age_kind %>
    <%= form.number_field :max_age_kind, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:max_age_kind].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:max_age_kind].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :risk_category %>
    <%= form.number_field :risk_category, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": reference_value.errors[:risk_category].none?, "border-red-400 focus:outline-red-600": reference_value.errors[:risk_category].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
