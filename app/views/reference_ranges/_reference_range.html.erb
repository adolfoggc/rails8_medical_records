<div id="<%= dom_id reference_range %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Gender related:</strong>
    <%= reference_range.gender_related %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Measure unit:</strong>
    <%= reference_range.measure_unit %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Reference:</strong>
    <%= reference_range.reference %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Medical test:</strong>
    <%= reference_range.medical_test_id %>
