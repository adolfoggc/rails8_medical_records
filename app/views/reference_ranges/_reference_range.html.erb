  <div>
    <strong class="block font-medium mb-1">Min age:</strong>
    <%= reference_range.min_age %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Min age kind:</strong>
    <%= reference_range.min_age_kind %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max age:</strong>
    <%= reference_range.max_age %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max age kind:</strong>
    <%= reference_range.max_age_kind %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Risk category:</strong>
    <%= reference_range.risk_category %>
  </div>
</div>
